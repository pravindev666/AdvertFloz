# AdvertFloz v1.7 — environment template. NAMES ONLY. Never put real values here.
# Copy to .env (gitignored) or use .streamlit/secrets.toml (gitignored) / OS keyring.

# --- Runtime mode ---
# local | demo | remote     (demo = clearly-labelled fixtures, no live provider calls)
ADVERTFLOZ_MODE=local
ADVERTFLOZ_DB_PATH=data/advertfloz.sqlite
ADVERTFLOZ_DEFAULT_TIMEZONE=Asia/Kolkata

# --- Hosted access control (required when the app is not bound to loopback) ---
ADVERTFLOZ_HOSTED=0
# Protect your dashboard with a master password (works locally or in the cloud):
ADVERTFLOZ_ADMIN_PASSWORD=
# Or protect with Cloudflare Zero Trust / OIDC email allowlist:
ADVERTFLOZ_OPERATOR_ALLOWLIST=
ADVERTFLOZ_OIDC_ISSUER=
ADVERTFLOZ_OIDC_CLIENT_ID=
ADVERTFLOZ_OIDC_CLIENT_SECRET=

# --- Local OAuth callback service (localhost only) ---
OAUTH_CALLBACK_HOST=127.0.0.1
OAUTH_CALLBACK_PORT=8765
ADVERTFLOZ_CONTROL_PLANE_URL=http://localhost:8501

# --- Meta Developer App (deployment-owner secret; enter in secret manager, never a form) ---
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/meta/callback
META_GRAPH_VERSION=v21.0

# --- Token encryption (key kept OUTSIDE the database) ---
# 32-byte key, urlsafe base64. Generate with: python -m advertfloz.infrastructure.security.crypto genkey
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=k1

# --- Optional notifications (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Remote plane (installer-owned) ---
WORKER_BASE_URL=
WORKER_SERVICE_KEY=

# --- Public base URL that Meta can fetch media from (required for real publishing) ---
ADVERTFLOZ_MEDIA_BASE_URL=

# --- Import limits (shown in the UI before upload) ---
ADVERTFLOZ_MAX_IMAGE_BYTES=8388608
ADVERTFLOZ_MAX_EXPANDED_BYTES=1000000000
ADVERTFLOZ_MAX_ARCHIVE_BYTES=262144000
